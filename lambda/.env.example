# Google Sheets Configuration
# Paste the entire contents of your Google Service Account JSON file here
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"..."}

# Your Google Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/ABC123xyz/edit
SPREADSHEET_ID=your-spreadsheet-id-here
